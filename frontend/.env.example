# Copy this file to .env.local for local development.
# On Vercel, add the same names under Project Settings -> Environment Variables.

# Neon Postgres connection string (use the "pooled" one from the Neon dashboard).
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Long random secret (at least 32 characters). Signs login cookies and email links.
SESSION_SECRET=replace-with-a-long-random-secret-of-32-plus-characters

# Public address of the site, no trailing slash.
PUBLIC_SITE_URL=http://localhost:3000

# LinkedIn Developer app ("Sign In with LinkedIn using OpenID Connect").
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Gmail SMTP: the Gmail address and a 16-character App Password.
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_NAME=Meet-N-Eat

# Set to 1 locally to print emails to the terminal instead of sending them.
EMAIL_DRY_RUN=1

# Secret the external scheduler (cron-job.org) sends to /api/cron.
CRON_SECRET=replace-with-another-long-random-secret

# Optional tuning.
# EMAIL_DAILY_CAP=480
# EMAIL_BATCH_SIZE=60
